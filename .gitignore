# Python
__pycache__/
*.py[codz]
*$py.class
*.egg-info/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Test and static-analysis caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Runtime caches. Not test output: the systemd unit points XDG_CACHE_HOME and
# DENO_DIR here (deploy/install-units.sh), so on the server this fills up.
.cache

# yt-dlp fragment artifacts: streaming to stdout can drop these in the CWD.
--Frag*
*.part
*.ytdl

*.log

# Secrets and credentials — never committed.
.env
.envrc
cookies.txt
*.pem

# Local assistant notes.
CLAUDE.md
.claude/
